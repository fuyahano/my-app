generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. ユーザーモデル
model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  products  Product[] @relation("SellerProducts") // 出品した教科書一覧
  purchases Product[] @relation("BuyerProducts")  // 購入した教科書一覧
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// 2. 教科書モデル
model Product {
  id          String   @id @default(uuid())
  title       String
  description String
  price       Int
  condition   String
  imageUrl    String
  isSoldOut   Boolean  @default(false) // 売り切れフラグ

  // 出品者との関係
  sellerId    String
  seller      User     @relation("SellerProducts", fields: [sellerId], references: [id])

  // 購入者との関係（最初は空OK）
  buyerId     String?
  buyer       User?    @relation("BuyerProducts", fields: [buyerId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}