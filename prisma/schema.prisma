datasource db {
  provider = "postgresql"

}

generator client {
  provider = "prisma-client-js"
}

// ユーザー情報
model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String   // ハッシュ化したパスワード
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[] @relation("SellerProducts") // 出品した商品
  purchases   Order[]   @relation("BuyerOrders")    // 購入した注文
}

// 商品（教科書）情報
model Product {
  id          String   @id @default(uuid())
  title       String
  description String
  price       Int
  condition   String
  imageUrl    String
  isSoldOut   Boolean  @default(false) // 💡 追加：売り切れフラグ（初期値は false = 出品中）
  buyerId     String?                  // 💡 追加：買った人のID（最初は空）
  sellerId    String
  seller      User     @relation(fields: [sellerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 注文（取引）情報
model Order {
  id          String      @id @default(uuid())
  createdAt   DateTime    @default(now())

  productId   String      @unique
  product     Product     @relation(fields: [productId], references: [id])
  buyerId     String
  buyer       User        @relation("BuyerOrders", fields: [buyerId], references: [id])
}

enum ProductStatus {
  AVAILABLE   // 販売中
  SOLD_OUT    // 売り切れ
}

enum Condition {
  NEW         // 新品
  GOOD        // 目立った傷なし
  USED        // 傷や汚れあり
}